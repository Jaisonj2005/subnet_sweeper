import tkinter as tk
from tkinter import ttk, messagebox
import subprocess
import threading
import platform
from concurrent.futures import ThreadPoolExecutor

# Global flag to stop the scan gracefully
is_scanning = False

def scan_ip(ip):
    if not is_scanning:
        return None
    
    # OS-specific ping arguments
    param = '-n' if platform.system().lower() == 'windows' else '-c'
    timeout_flag = '-w' if platform.system().lower() == 'windows' else '-W'
    timeout_val = '500' if platform.system().lower() == 'windows' else '1'
    
    command = ['ping', param, '1', timeout_flag, timeout_val, ip]
    
    try:
        # CREATE_NO_WINDOW = 0x08000000 prevents black console windows from flashing on Windows
        creationflags = 0x08000000 if platform.system().lower() == 'windows' else 0
        output = subprocess.check_output(command, stderr=subprocess.STDOUT, universal_newlines=True, creationflags=creationflags)
        
        # Valid ICMP replies on Windows contain the string "TTL="
        if "TTL=" in output.upper():
            return ip
    except subprocess.CalledProcessError:
        # Host is down or ICMP is blocked
        pass
    return None

def start_scan():
    global is_scanning
    subnet_input = entry_subnet.get().strip()
    
    # Basic validation for an IPv4 prefix (e.g., 192.168.1)
    parts = subnet_input.split('.')
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        messagebox.showerror("Input Error", "Please enter a valid /24 subnet prefix (e.g., 192.168.1)")
        return
        
    is_scanning = True
    btn_start.config(state=tk.DISABLED)
    btn_stop.config(state=tk.NORMAL)
    text_log.config(state=tk.NORMAL)
    text_log.delete(1.0, tk.END)
    text_log.insert(tk.END, f"[*] Starting ICMP Sweep on {subnet_input}.0/24...\n")
    text_log.insert(tk.END, "-" * 55 + "\n")
    text_log.config(state=tk.DISABLED)
    lbl_status.config(text="Sweeping network...", fg="#e67e22")
    
    threading.Thread(target=execute_sweep, args=(subnet_input,), daemon=True).start()

def execute_sweep(subnet_prefix):
    global is_scanning
    active_hosts = []
    
    # Use ThreadPoolExecutor to ping up to 50 IPs concurrently
    with ThreadPoolExecutor(max_workers=50) as executor:
        # Generate the target range: .1 through .254
        ips = [f"{subnet_prefix}.{i}" for i in range(1, 255)]
        
        # Map the scan_ip function to the list of IPs
        for result in executor.map(scan_ip, ips):
            if not is_scanning:
                break
            if result:
                active_hosts.append(result)
                insert_log(f"[+] Active Host Found: {result}\n", "success")
    
    if is_scanning:
        insert_log("-" * 55 + f"\n[*] Sweep Complete. Found {len(active_hosts)} active hosts.\n")
    else:
        insert_log("-" * 55 + "\n[!] Sweep Aborted by user.\n")
        
    root.after(0, reset_ui)

def insert_log(message, tag=None):
    text_log.config(state=tk.NORMAL)
    text_log.insert(tk.END, message, tag)
    text_log.see(tk.END)
    text_log.config(state=tk.DISABLED)

def stop_scan():
    global is_scanning
    is_scanning = False
    lbl_status.config(text="Stopping...", fg="#c0392b")

def reset_ui():
    btn_start.config(state=tk.NORMAL)
    btn_stop.config(state=tk.DISABLED)
    lbl_status.config(text="Ready", fg="#7f8c8d")

# --- Tkinter GUI Layout ---
root = tk.Tk()
root.title("SOC Toolkit - Subnet Ping Sweeper")
root.geometry("600x520")
root.resizable(False, False)

frame = ttk.Frame(root, padding="15")
frame.pack(fill=tk.BOTH, expand=True)

lbl_title = tk.Label(frame, text="Local Subnet ICMP Sweeper", font=("Helvetica", 13, "bold"))
lbl_title.pack(anchor="w", pady=(0, 15))

# Target Configuration
config_frame = tk.Frame(frame)
config_frame.pack(fill=tk.X, pady=(0, 15))

tk.Label(config_frame, text="Subnet Prefix:", font=("Helvetica", 9, "bold")).grid(row=0, column=0, sticky="w", pady=5)
entry_subnet = ttk.Entry(config_frame, width=15, font=("Consolas", 10))
entry_subnet.grid(row=0, column=1, padx=10, pady=5, sticky="w")

# Automatically detect local subnet to pre-fill the box
try:
    import socket
    local_ip = socket.gethostbyname(socket.gethostname())
    local_prefix = ".".join(local_ip.split('.')[:3])
    entry_subnet.insert(0, local_prefix)
except:
    entry_subnet.insert(0, "192.168.1")

tk.Label(config_frame, text=".X/24 (Scans .1 to .254)", font=("Helvetica", 9, "italic"), fg="#555").grid(row=0, column=2, sticky="w")

# Controls
control_frame = tk.Frame(frame)
control_frame.pack(fill=tk.X, pady=(10, 10))

btn_start = tk.Button(control_frame, text="Sweep Subnet", command=start_scan, bg="#2980b9", fg="white", font=("Helvetica", 9, "bold"), width=15)
btn_start.pack(side=tk.LEFT, padx=(0, 10))

btn_stop = tk.Button(control_frame, text="Stop", command=stop_scan, bg="#c0392b", fg="white", font=("Helvetica", 9, "bold"), width=10, state=tk.DISABLED)
btn_stop.pack(side=tk.LEFT)

lbl_status = tk.Label(control_frame, text="Ready", font=("Consolas", 9), fg="#7f8c8d")
lbl_status.pack(side=tk.RIGHT, padx=(0, 5))

# Output Console
text_frame = tk.Frame(frame)
text_frame.pack(fill=tk.BOTH, expand=True)

scrollbar = tk.Scrollbar(text_frame)
scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

text_log = tk.Text(text_frame, font=("Consolas", 10), bg="#1e1e1e", fg="#ecf0f1", yscrollcommand=scrollbar.set)
text_log.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
text_log.tag_config("success", foreground="#2ecc71")
text_log.config(state=tk.DISABLED)

scrollbar.config(command=text_log.yview)

root.mainloop()